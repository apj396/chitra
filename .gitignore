# Runtime output, never committed: run_output holds generated campaigns and
# audit/ holds the ledger. A repository shipping a pre-filled audit trail is
# shipping evidence nobody can verify the provenance of.
run_output/
audit/
cultural_audits.json
__pycache__/
*.pyc
.venv/
.env

